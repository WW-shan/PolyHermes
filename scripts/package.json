{
  "name": "polyhermes-scripts",
  "version": "1.0.0",
  "description": "Utility scripts for Polyhermes",
  "type": "module",
  "scripts": {
    "unwrap-wcol": "node unwrap-wcol.js",
    "get-order-detail": "node get-order-detail.js",
    "verify-backtest-data": "node verify-backtest-data.js",
    "ws-binance-klines": "node ws_binance_btc_usdc_klines.js",
    "test:complete-set-arb": "node --test test/scan-event-complete-set-arbitrage.test.mjs",
    "test:complete-set-monitor": "node --test test/monitor-event-complete-set-arbitrage.test.mjs",
    "test:complete-set": "node --test test",
    "test:complete-set-risk": "node --test test/complete-set-basket-risk.test.mjs test/analyze-complete-set-execution-risk.test.mjs",
    "analyze:complete-set-risk": "node analyze-complete-set-execution-risk.mjs",
    "test:leader-pnl": "node --test test/leader-pnl-snapshot.test.mjs",
    "snapshot:leader-pnl": "node snapshot-leader-pnl.mjs",
    "scan:complete-set:all": "node scan-event-complete-set-arbitrage.mjs --all-markets --max-markets-per-tag 100000 --max-groups 100000 --min-volume 0 --concurrency 12",
    "test:paper-execute": "node --test test/paper-execute-complete-set.test.mjs",
    "paper:complete-set": "node paper-execute-complete-set.mjs"
  },
  "dependencies": {
    "@ethersproject/wallet": "^5.7.0",
    "ethers": "^5.7.1",
    "@polymarket/clob-client": "^5.2.1",
    "ws": "^8.18.0"
  }
}
